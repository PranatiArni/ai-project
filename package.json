{
  "name": "sensory-trip-prep",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev -- --host 0.0.0.0",
    "start": "node server/index.js",
    "build": "npm --prefix client run build",
    "lint": "npm --prefix client run lint",
    "test": "node --test server/*.test.js",
    "test:browser": "node scripts/browser-test.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
